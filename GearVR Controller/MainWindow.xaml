<Window x:Class="GearVR_Controller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GearVR_Controller"
        Title="Gear VR Controller" Width="1040" Height="790" MinWidth="850" MinHeight="650"
        Background="#0E1421" Foreground="#EAF0FA" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#9BAAC0"/>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#EAF0FA"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#DAE4F2"/><Setter Property="Margin" Value="0,6"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#0E1727"/><Setter Property="Foreground" Value="#F0F5FF"/><Setter Property="BorderBrush" Value="#36465E"/><Setter Property="Padding" Value="10,8"/></Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#ECF4FF"/><Setter Property="Background" Value="#293C56"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="13,8"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="border" Property="Opacity" Value="0.75"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="border" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#182437"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,0,14"/><Setter Property="BorderBrush" Value="#283A52"/><Setter Property="BorderThickness" Value="1"/></Style>
        <Style x:Key="Heading" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="16"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
        <Style x:Key="BindingButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Margin" Value="3"/><Setter Property="MinWidth" Value="70"/><Setter Property="Background" Value="#304862"/></Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <Grid Margin="28,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="1.05*"/></Grid.ColumnDefinitions>
        <StackPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,20">
          <TextBlock Text="GEAR VR  /  WINDOWS" Foreground="#64D6C9" FontWeight="Bold" FontSize="11"/>
          <TextBlock Text="Controla tu PC con movimiento" FontSize="27" FontWeight="SemiBold" Margin="0,4,0,3"/>
          <TextBlock Text="Conecta tu mando, ajusta el puntero y personaliza sus botones." Foreground="{StaticResource Muted}"/>
        </StackPanel>
        <Border Style="{StaticResource Card}" Grid.Row="1" Grid.Column="0">
          <StackPanel>
            <DockPanel><TextBlock Text="Conexión" Style="{StaticResource Heading}"/><Ellipse Fill="{Binding Source={x:Static local:Settings.Default}, Path=_Status}" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,0,0"/></DockPanel>
            <TextBlock Text="Dirección Bluetooth del mando" Foreground="{StaticResource Muted}" Margin="0,2,0,6"/>
            <DockPanel LastChildFill="True">
              <Button x:Name="DetectButton" DockPanel.Dock="Right" Content="Detectar" Click="DetectButton_Click" Margin="8,0,0,0"/>
              <TextBox x:Name="MACAddressText" Text="{Binding Source={x:Static local:User.Default}, Path=MACAddressText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
            </DockPanel>
            <ComboBox x:Name="DetectedDevices" Visibility="Collapsed" SelectionChanged="DetectedDevices_SelectionChanged" Margin="0,8,0,0" ToolTip="Selecciona el mando que quieres conectar"/>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,4"><Button x:Name="ConnectButton" Content="Conectar" Background="#167E84" Click="ConnectButton_Click" Margin="0,0,8,0"/><Button Content="Desconectar" Click="PowerOffButton_Click"/></StackPanel>
            <CheckBox x:Name="CheckBoxAutoConnect" Checked="AutoConnect_Changed" Unchecked="AutoConnect_Changed" IsChecked="{Binding Source={x:Static local:User.Default}, Path=AutoConnect, Mode=TwoWay}" Content="Conectar y reconectar autom&#225;ticamente"/>
            <TextBlock x:Name="ConnectionMessage" Text="Desconectado." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,2"/>
            <CheckBox x:Name="StartupCheckBox" Content="Iniciar con Windows, minimizado" Checked="StartupCheckBox_Changed" Unchecked="StartupCheckBox_Changed"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Grid.Row="1" Grid.Column="2">
          <StackPanel>
            <TextBlock Text="Puntero por movimiento" Style="{StaticResource Heading}"/>
            <TextBlock Text="Apunta el mando para dirigir el cursor." Foreground="{StaticResource Muted}"/>
            <CheckBox x:Name="MotionPointerCheckBox" IsChecked="{Binding Source={x:Static local:User.Default}, Path=MotionPointer, Mode=TwoWay}" Content="Activar apuntado con giroscopio" Margin="0,14,0,8" Checked="MotionPointerCheckBox_Changed" Unchecked="MotionPointerCheckBox_Changed"/>
            <DockPanel Margin="0,7,0,0"><TextBlock Text="Sensibilidad"/><TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="#64D6C9" Text="{Binding Source={x:Static local:User.Default}, Path=MotionSensitivity, StringFormat={}{0:0.00}x}"/></DockPanel>
            <Slider x:Name="SensitivitySlider" Minimum="0.25" Maximum="3" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding Source={x:Static local:User.Default}, Path=MotionSensitivity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ValueChanged="SensitivitySlider_Changed" Margin="0,8,0,4"/>
            <TextBlock Text="Mantén HOME un segundo para centrar y calibrar." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Grid.Row="2" Grid.ColumnSpan="3">
          <StackPanel>
            <TextBlock Text="Asignación de botones" Style="{StaticResource Heading}"/>
            <TextBlock Text="Selecciona una zona o bot&#243;n para cambiar su acci&#243;n; pasa el cursor para ver la asignaci&#243;n." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0">
                <TextBlock Text="PULSAR TOUCHPAD" Foreground="#64D6C9" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="Pulsa una zona del panel" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                <Canvas Width="214" Height="214" HorizontalAlignment="Center" Margin="0,8,0,0"><Ellipse Width="208" Height="208" Canvas.Left="3" Canvas.Top="3" Fill="#101B2C" Stroke="#45627A" StrokeThickness="2"/><Button Canvas.Left="78" Canvas.Top="8" Width="58" Height="54" Padding="2" Content="Arriba" Click="TouchTopButton_Click" ToolTip="{Binding Source={x:Static local:User.Default}, Path=TouchTopButton}"/><Button Canvas.Left="12" Canvas.Top="78" Width="58" Height="54" Padding="2" Content="Izq." Click="TouchLeftButton_Click" ToolTip="{Binding Source={x:Static local:User.Default}, Path=TouchLeftButton}"/><Button Canvas.Left="78" Canvas.Top="78" Width="58" Height="54" Padding="2" Content="Centro" Click="TouchMidButton_Click" ToolTip="{Binding Source={x:Static local:User.Default}, Path=TouchMidButton}"/><Button Canvas.Left="144" Canvas.Top="78" Width="58" Height="54" Padding="2" Content="Der." Click="TouchRightButton_Click" ToolTip="{Binding Source={x:Static local:User.Default}, Path=TouchRightButton}"/><Button Canvas.Left="78" Canvas.Top="148" Width="58" Height="54" Padding="2" Content="Abajo" Click="TouchBotButton_Click" ToolTip="{Binding Source={x:Static local:User.Default}, Path=TouchBotButton}"/></Canvas>
              </StackPanel>
              <StackPanel Grid.Column="1">
                <TextBlock Text="GATILLO + TOUCHPAD" Foreground="#64D6C9" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="Toca una zona y pulsa el gatillo" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                <Canvas Width="214" Height="214" HorizontalAlignment="Center" Margin="0,8,0,0"><Ellipse Width="208" Height="208" Canvas.Left="3" Canvas.Top="3" Fill="#101B2C" Stroke="#45627A" StrokeThickness="2"/><Button Canvas.Left="78" Canvas.Top="8" Width="58" Height="54" Padding="2" Content="Arriba" Click="TriggerTopButton_Click" ToolTip="{Binding Source={x:Static local:User.Default}, Path=TriggerTopButton}"/><Button Canvas.Left="12" Canvas.Top="78" Width="58" Height="54" Padding="2" Content="Izq." Click="TriggerLeftButton_Click" ToolTip="{Binding Source={x:Static local:User.Default}, Path=TriggerLeftButton}"/><Button Canvas.Left="78" Canvas.Top="78" Width="58" Height="54" Padding="2" Content="Centro" Click="TriggerMidButton_Click" ToolTip="{Binding Source={x:Static local:User.Default}, Path=TriggerMidButton}"/><Button Canvas.Left="144" Canvas.Top="78" Width="58" Height="54" Padding="2" Content="Der." Click="TriggerRightButton_Click" ToolTip="{Binding Source={x:Static local:User.Default}, Path=TriggerRightButton}"/><Button Canvas.Left="78" Canvas.Top="148" Width="58" Height="54" Padding="2" Content="Abajo" Click="TriggerBotButton_Click" ToolTip="{Binding Source={x:Static local:User.Default}, Path=TriggerBotButton}"/></Canvas>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="BOTONES DEL MANDO" Foreground="#64D6C9" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock Text="Frente del mando; gatillo en la parte posterior" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                <Canvas Width="235" Height="235" HorizontalAlignment="Center" Margin="0,4,0,0">
                  <Border Canvas.Left="43" Canvas.Top="3" Width="136" Height="225" CornerRadius="65,65,58,58" Background="#0F1929" BorderBrush="#48617B" BorderThickness="2"/>
                  <Ellipse Canvas.Left="65" Canvas.Top="18" Width="92" Height="92" Fill="#22354B" Stroke="#53708B" StrokeThickness="2"/>
                  <TextBlock Canvas.Left="84" Canvas.Top="53" Text="PANEL" Foreground="#9BAAC0" FontSize="11"/>
                  <Button Canvas.Left="48" Canvas.Top="119" Width="58" Height="30" Padding="0" Content="Atr&#225;s" Click="BackButton_Click" ToolTip="{Binding Source={x:Static local:User.Default}, Path=BackButton}"/>
                  <Button Canvas.Left="117" Canvas.Top="119" Width="58" Height="30" Padding="0" Content="Home" Click="HomeButton_Click" ToolTip="{Binding Source={x:Static local:User.Default}, Path=HomeButton}"/>
                  <Button Canvas.Left="53" Canvas.Top="161" Width="48" Height="31" Padding="0" Content="Vol +" Click="VolumeUpButton_Click" ToolTip="{Binding Source={x:Static local:User.Default}, Path=VolumeUpButton}"/>
                  <Button Canvas.Left="120" Canvas.Top="161" Width="48" Height="31" Padding="0" Content="Vol -" Click="VolumeDownButton_Click" ToolTip="{Binding Source={x:Static local:User.Default}, Path=VolumeDownButton}"/>
                  <Button Canvas.Left="179" Canvas.Top="76" Width="54" Height="72" Padding="2" Background="#167E84" Content="Gatillo" Click="TriggerButton_Click" ToolTip="{Binding Source={x:Static local:User.Default}, Path=TriggerButton}"/>
                </Canvas>
                <Button Content="Velocidad de la rueda" HorizontalAlignment="Center" Padding="10,6" Click="ScrollWheelSpeed_Click"/>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource Card}" Grid.Row="3" Grid.ColumnSpan="3"><StackPanel><TextBlock Text="Sensores" Style="{StaticResource Heading}"/><TextBlock Text="Activa las lecturas que quieras consultar." Foreground="{StaticResource Muted}"/><WrapPanel Margin="0,8,0,0"><StackPanel Margin="0,0,25,0"><CheckBox Content="Touchpad" IsChecked="{Binding Source={x:Static local:User.Default}, Path=Axis, Mode=TwoWay}" Checked="AxisCheckBox_Changed" Unchecked="AxisCheckBox_Changed"/><TextBlock Text="{Binding AxisX, StringFormat=X: {0}}"/><TextBlock Text="{Binding AxisY, StringFormat=Y: {0}}"/></StackPanel><StackPanel Margin="0,0,25,0"><CheckBox Content="Giroscopio" IsChecked="{Binding Source={x:Static local:User.Default}, Path=Gyro, Mode=TwoWay}" Checked="GyroCheckBox_Changed" Unchecked="GyroCheckBox_Changed"/><TextBlock Text="{Binding GyroX, StringFormat=X: {0}}"/><TextBlock Text="{Binding GyroY, StringFormat=Y: {0}}"/><TextBlock Text="{Binding GyroZ, StringFormat=Z: {0}}"/></StackPanel><StackPanel Margin="0,0,25,0"><CheckBox Content="Acelerómetro" IsChecked="{Binding Source={x:Static local:User.Default}, Path=Accel, Mode=TwoWay}" Checked="AccelCheckBox_Changed" Unchecked="AccelCheckBox_Changed"/><TextBlock Text="{Binding AccelX, StringFormat=X: {0}}"/><TextBlock Text="{Binding AccelY, StringFormat=Y: {0}}"/><TextBlock Text="{Binding AccelZ, StringFormat=Z: {0}}"/></StackPanel><StackPanel><CheckBox Content="Magnetómetro" IsChecked="{Binding Source={x:Static local:User.Default}, Path=Magnet, Mode=TwoWay}" Checked="MagnetCheckBox_Changed" Unchecked="MagnetCheckBox_Changed"/><TextBlock Text="{Binding MagnetX, StringFormat=X: {0}}"/><TextBlock Text="{Binding MagnetY, StringFormat=Y: {0}}"/><TextBlock Text="{Binding MagnetZ, StringFormat=Z: {0}}"/></StackPanel></WrapPanel></StackPanel></Border>
      </Grid>
    </ScrollViewer>
</Window>
